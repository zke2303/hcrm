server:
  port: 8080
  mode: debug  # debug, release, test

database:
  host: localhost
  port: 3306
  username: root
  password: ""
  database: hcrm
  charset: utf8mb4
  max_idle_conns: 10
  max_open_conns: 100

redis:
  host: localhost
  port: 6379
  password: ""
  db: 0

log:
  level: debug  # debug, info, warn, error
  output: stdout  # stdout, file
  filename: logs/app.log
  max_size: 100  # MB
  max_backups: 3
  max_age: 28  # days
  compress: true